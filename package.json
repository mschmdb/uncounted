{
	"name": "uncounted",
	"version": "0.1.0",
	"private": true,
	"description": "Browser extension to exclude your own visits from Plausible Analytics",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"icons": "node scripts/icons.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node scripts/build.mjs --e2e && playwright test",
		"package": "pnpm build && node scripts/package.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/chrome": "^0.3.7",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.0",
		"axe-core": "^4.14.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"playwright": "^1.65.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@lucide/svelte": "^1.61.0"
	}
}
